# DUBO ROV Controller — Raspberry Pi auto-start
#
# TEMPLATE — this file is NOT valid on its own. `scripts/start.sh` renders the
# @ROV_*@ tokens below into /etc/systemd/system/rov-controller.service using the
# deployment path, user and virtualenv python DISCOVERED at install time, then
# reloads and enables it. Keeps the checked-in unit portable across machines.
#
# Behaviour:
#   * starts after the graphical target is up (Qt GUI needs the desktop/XWayland)
#   * runs as the user who owns the project directory (never root)
#   * GUI environment (DISPLAY/XAUTHORITY/QT_QPA_PLATFORM) comes from
#     /etc/rov-controller.env, generated by scripts/start.sh from the live session
#   * `Restart=on-failure` -> crashes restart; clean exit (window closed) and
#     `systemctl stop` do NOT restart (no loop), systemd guarantees one instance
#   * logs go to journald (see `journalctl -u rov-controller.service -f`)
[Unit]
Description=DUBO ROV Controller GUI
Wants=graphical.target
After=graphical.target

[Service]
Type=simple
User=@ROV_USER@
EnvironmentFile=-/etc/rov-controller.env
WorkingDirectory=@ROV_DIR@
ExecStart=@ROV_PYTHON@ app/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=graphical.target